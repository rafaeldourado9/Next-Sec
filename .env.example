# ─── Segurança (OBRIGATÓRIO mudar em produção) ──────────────────────────────
# openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32

# Chave usada pelos plugins analytics para autenticar na API
# Header: Authorization: ApiKey <key>
VMS_API_KEY=dev-analytics-key-change-in-production

# ─── Domínio ─────────────────────────────────────────────────────────────────
# Em produção: seu domínio real
DOMAIN=localhost

# ─── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_USER=next_sec
POSTGRES_DB=next_sec
POSTGRES_PASSWORD=next_sec_dev
DATABASE_URL=postgresql+asyncpg://next_sec:next_sec_dev@postgres:5432/next_sec

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=next_sec
RABBITMQ_PASSWORD=next_sec_dev
RABBITMQ_URL=amqp://next_sec:next_sec_dev@rabbitmq:5672/

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MediaMTX (leitura de frames pelo analytics — sem gravação contínua) ────
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTMP_URL=rtmp://mediamtx:1935

# URL pública RTMP — usada no wizard para o integrador configurar a câmera/agente
# Em produção: rtmp://<dominio-ou-ip-da-vps>:1935
RTMP_PUBLIC_URL=rtmp://localhost:1935

# ─── Analytics (serviço standalone — plugins intrusion + face_recognition) ──
ANALYTICS_FPS=3
YOLO_IMGSZ=640
YOLO_CONF=0.30
YOLO_MODEL_PATH=/models/object.pt
# Preenchido quando o modelo de reconhecimento facial real for integrado
# (ver .genesis/architecture/reuse-plan.md, gap "Modelo de reconhecimento facial real")
FACE_RECOGNITION_MODEL_PATH=

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_CAMERAS=200

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_WEBHOOKS=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=60/minute

# ─── MinIO (staging S3-compatível antes do StorageProvider final — ADR-010) ─
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniosecret
MINIO_BUCKET_SNAPSHOTS=nextsec-snapshots
MINIO_BUCKET_ANALYTICS=nextsec-analytics
MINIO_BUCKET_CLIPS=nextsec-clips

# ─── Storage Provider (destino final do clipe/frame — ADR-010 revisado) ────
STORAGE_PROVIDER=local
CLIP_RETENTION_DAYS=30

# ─── Notification Channel (canal de alerta ao contato — ADR-009) ───────────
NOTIFICATION_CHANNEL=whatsapp
ARCANUM_BASE_URL=http://arcanum:3100
ARCANUM_INSTANCE_NAME=next-sec

# ─── Túnel WireGuard do agent (resolve CGNAT — ver plano do túnel) ─────────
WG_CONTROL_TOKEN=dev-wg-control-key-change-in-production
# host:port público que o agent disca de fora — em produção, o domínio/IP
# da VPS na porta UDP exposta (ex: vpn.seudominio.com:51820)
WG_PUBLIC_ENDPOINT=localhost:51820
WG_SUBNET=10.60.0.0/24

# ─── Backup ──────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
