# ── Servidor HTTPS ────────────────────────────────────────────────────────
# O Next Sec passou a terminar TLS ele mesmo: a VPS deixou de ser
# compartilhada com o FastOS (que era quem fazia isso, ver
# docs/DEPLOY_VPS.md). Certificado emitido por certbot webroot usando o
# desafio ACME servido pelo bloco :80 acima.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    client_max_body_size 10m;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Content-Type-Options "nosniff"                    always;
    add_header X-Frame-Options        "DENY"                       always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/locations.conf;
}
