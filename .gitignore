# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.venv-native/
build/

# Instalador nativo — binários (PyInstaller + nssm.exe de terceiros), não
# vão pro git. install.ps1/uninstall.ps1/*.bat continuam versionados.
native_installer/windows/release/*.exe
native_installer/windows/nssm.exe

# Node / frontend
node_modules/
dist/
frontend/dist/

# Env
.env
.env.*
!.env.example

# Docker / data volumes (bind mounts locais, se usados em dev)
*.log

# IDE
.vscode/
.idea/

# Modelos de IA (binários grandes — baixados sob demanda, não versionados;
# GFPGANv1.4.pth sozinho já excede o limite de 100MB do GitHub). Ver
# comentários em analytics/core/frame_enhance.py e config.py pra origem.
analytics/models/*.pb
analytics/models/*.pth
!analytics/models/FSRCNN_x4.pb
