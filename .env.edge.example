# ─────────────────────────────────────────────────────────────────────────
# Next Sec — Edge Nível 1 (Docker dedicado no hardware do cliente)
#
# Variáveis para `docker-compose.edge.yml`. Copie para `.env.edge` no
# hardware do cliente e preencha antes de subir:
#   docker compose -f docker-compose.edge.yml --env-file .env.edge up -d
#
# Ver ADR-016 (.genesis/architecture/adrs/016-edge-two-tier-deployment.md) e
# ADR-017 (.genesis/architecture/adrs/017-edge-sync-protocol.md).
# ─────────────────────────────────────────────────────────────────────────

# ─── VPS central (via túnel WireGuard) ─────────────────────────────────────
# NUNCA use localhost/127.0.0.1 — este stack roda no hardware do cliente,
# não na VPS. Este compose de edge NÃO tem um serviço `api` local (ver
# comentário no topo do docker-compose.edge.yml) — todo evento e clipe
# atravessa a rede até a VPS central.
#
# VMS_API_URL deve ser o endereço da VPS central ALCANÇÁVEL VIA O TÚNEL
# WIREGUARD já configurado para este cliente — mesmo padrão que o
# `edge-agent` já usa hoje em `docker-compose.yml` (serviço `wireguard`,
# hub em `infra/wireguard/`): o cliente é um peer desse túnel, e o endereço
# aqui é o IP interno do hub (sub-rede `WG_SUBNET`, default 10.60.0.0/24)
# na porta da API central — NÃO o IP público da VPS direto (a porta 8000
# da API central não é exposta publicamente, só através do túnel).
VMS_API_URL=http://10.60.0.1:8000

# API key deste tenant/agente específico, gerada na VPS central (tabela
# api_keys). Autentica tanto o `analytics` (multipart em
# POST /plugins/events) quanto o `worker` de edge (PUT .../clip) via header
# "Authorization: ApiKey <key>". NÃO reutilize a `dev-analytics-key` do
# `.env.example` central — cada cliente/tenant deve ter a sua própria.
VMS_API_KEY=change-me-tenant-specific-api-key

# ─── Analytics — build target ──────────────────────────────────────────────
# cpu  = default seguro, roda em qualquer hardware x86_64
# gpu  = exige GPU NVIDIA + driver CUDA instalado no host do cliente
ANALYTICS_TARGET=cpu

# ─── Analytics — parâmetros de inferência (mesmos defaults do compose
# central — ajuste conforme o hardware/câmeras deste cliente) ─────────────
ANALYTICS_FPS=3
YOLO_IMGSZ=640
YOLO_CONF=0.30
YOLO_MODEL_PATH=/models/object.pt

# Vazio = reconhecimento facial desabilitado neste cliente (o gate de LGPD
# — tenant.facial_recognition_enabled — continua avaliado na VPS central;
# esta variável só controla se o modelo é carregado localmente ou não).
FACE_RECOGNITION_MODEL_PATH=

# ─── Observabilidade ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
